# Sediment frontend env — copy to .env.local for local dev, or set in Vercel.

# --- API base ---
# Both point at the single Fly app (nginx fronts all 4 services on one host;
# it path-routes /api/v1/* → platform and the langgraph stream path).
# Live Fly app: https://hypeproof-sediment.fly.dev
#
# Local dev: the Fly API CORS-allowlists only the Vercel/hypeproof origins,
# NOT localhost. So set the bases to this dev server's own origin and let the
# Next rewrite (enabled by SEDIMENT_DEV_API_PROXY) proxy to Fly server-side.
# Prod: set these to the real Fly URL and add the deployed origin to the
# backend CORS allowlist instead (no proxy needed).
NEXT_PUBLIC_SEDIMENT_PLATFORM_URL=http://localhost:3001
NEXT_PUBLIC_SEDIMENT_LANGGRAPH_URL=http://localhost:3001
SEDIMENT_DEV_API_PROXY=https://hypeproof-sediment.fly.dev

# --- NextAuth (Auth.js v5) GitHub SSO ---
# AUTH_SECRET: any 32-byte random hex — `openssl rand -hex 32`.
AUTH_SECRET=

# GitHub OAuth App credentials. ONE-TIME SETUP (Jay's GitHub account):
#   1. https://github.com/settings/developers → New OAuth App
#   2. Application name: Sediment (local dev)
#      Homepage URL:            http://localhost:3001
#      Authorization callback:  http://localhost:3001/api/auth/callback/github
#      (for prod add a second OAuth App with the deployed domain's callback)
#   3. Generate a client secret; paste both below.
# Member resolution is by GitHub *username* → members.github_login
# (data/members.json + `make seed`), NOT by GitHub email.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
