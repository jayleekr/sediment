# Sediment frontend env — copy to .env.local for local dev, or set in Vercel.
#
# Both point at the single Fly app (nginx fronts all 4 services on one host;
# it path-routes /api/v1/* → platform and the langgraph stream path internally).
# Live Fly app: https://hypeproof-sediment.fly.dev
#
# Leaving these unset makes app/sediment/lib/api.ts fall back to
# http://localhost:10100 / :10020 (local backend dev).

NEXT_PUBLIC_CURATOR_PLATFORM_URL=https://hypeproof-sediment.fly.dev
NEXT_PUBLIC_CURATOR_LANGGRAPH_URL=https://hypeproof-sediment.fly.dev
