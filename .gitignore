# Auto-updated pointers to most-recent validation run — noise in commits.
output/validation/P*-latest.json
output/validation/P*-latest.md
# Per-run metric history — VM/CI-local, uploaded as a workflow artifact.
output/validation/history/
# Playwright screenshots from E2E runs (local dev + CI smoke uploads).
output/validation/screenshots/
# Ralph runtime state — restored from templates each run.
harness/ralph/STATE.json
harness/ralph/TODO.md
harness/ralph/JOURNAL.md
# Per-iter logs from ralph supervisor.
output/ralph/iter-*.log
output/ralph/iter-*.json
output/ralph/iter-*.prompt
output/ralph/iter-*.bak
output/ralph/supervisor.log
output/dogfood/*.json
# AI commit ephemeral state files (per-CHECK_ID).
output/ai-commit/

# Rendered launchd plist (generated by install-p3-cron.sh from .plist.tmpl).
# Contains absolute paths specific to the local machine — never commit.
harness/scripts/com.hypeproof.sediment.p3-validator.plist

# Cron output (renders into output/ via rendered plist).
output/cron/

# Review reports — large + reviewer-noise, share via SendUserFile.
output/reviews/

# Worktree directory created by .codex tooling.
.codex/

# gstack skill clone — 51MB methodology repo used as in-session reference only.
# Cloned via: git clone --depth 1 https://github.com/garrytan/gstack.git \
#   .claude/skills/gstack/  (per review session 2026-05-23).
.claude/skills/gstack/

# Git worktrees created for parallel branches — never commit these.
.claude/worktrees/

# Personal asset dumps (KakaoTalk photos, internal docs) — local only.
assets/

