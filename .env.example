# AI Curator — local development env
# Copy to .env and fill in real values. .env is gitignored.

# ===== Database =====
# docker-compose maps Postgres to 5433 to avoid clashing with system PG
DATABASE_URL_APP=postgresql+asyncpg://curator_app:curator_app_local@localhost:5433/curator
DATABASE_URL_SERVICE=postgresql+asyncpg://curator_service:curator_service_local@localhost:5433/curator
REDIS_URL=redis://localhost:6380/0

# ===== LLM Provider (multi-provider strategy) =====
# Pick ONE for active provider. Auto-detected if blank, in order:
#   anthropic key → anthropic ; gemini key → gemini ; claude CLI installed → claude_cli ; else offline
#
# Recommended:
#   dev / Jay solo dogfood    → claude_cli   (uses MAX subscription, $0)
#   production free tier      → gemini       (Flash: ~$0.0006/query, 50x cheaper than Sonnet)
#   production business tier  → anthropic    (Sonnet 4.6, premium quality)
#   CI / no keys              → offline      (deterministic mock)
LLM_PROVIDER=claude_cli

# ===== LLM keys (only the active provider's key is used) =====
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza-...        # Gemini API key (https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-2.5-flash  # gemini-2.5-flash | gemini-2.5-pro | gemini-2.5-flash-lite
OPENAI_API_KEY=sk-...           # embeddings only (or use Gemini embedding-004 instead)

# ===== Embedding =====
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai       # openai | gemini  (gemini text-embedding-004 if cost-sensitive)

# ===== LLM models (used when provider doesn't override) =====
LLM_MODEL_DEFAULT=claude-sonnet-4-6
LLM_MODEL_HEAVY=claude-opus-4-7

# ===== Auth (NextAuth.js) =====
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email magic link (Resend or SMTP)
EMAIL_FROM=curator@hypeproof-ai.xyz
RESEND_API_KEY=re_...

# Discord OAuth (optional — for HypeProof Lab tenant)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ===== Service ports =====
CURATOR_PLATFORM_PORT=10100
CURATOR_LANGGRAPH_PORT=10020
VAULT_INGESTER_PORT=11000
METADATA_SVC_PORT=12000
WORKSPACE_MCP_PORT=8888
GUARDRAILS_PORT=8889

# ===== JWT (inter-service) =====
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_ISSUER=ai-curator-local
JWT_AUDIENCE=ai-curator-services

# ===== Cost guardrails =====
COST_BUDGET_MONTHLY_USD=200
QUERY_RATELIMIT_PER_MIN=20
INGEST_RATELIMIT_PER_HOUR=1000

# ===== Default tenant (dogfooding) =====
DEFAULT_TENANT_SLUG=hypeproof-lab
DEFAULT_TENANT_NAME=HypeProof Lab

# ===== Vault paths (relative to repo root) =====
VAULT_REPO_ROOT=../../..
VAULT_INGEST_PATHS=research/daily,web/src/content/columns,web/src/content/novels,web/src/content/research

# ===== Stripe (Phase 7+) =====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json
